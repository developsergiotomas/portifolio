# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# HTML, llms*.txt, sitemap and CVs keep the Pages default (max-age=0 + ETag) so every deploy shows up immediately.

# Content-hashed build output (JS, CSS, fonts): the URL changes when the content does.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Logos, profile photo and favicon: not fingerprinted, rarely change.
/tech/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/profile.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
